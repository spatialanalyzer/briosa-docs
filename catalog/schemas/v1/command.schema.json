{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://spatialanalyzer.github.io/briosa-docs/catalog/schemas/v1/command.schema.json",
  "title": "Briosa MP catalog command record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "exact_target",
    "command_id",
    "slug",
    "mp_step",
    "category_path",
    "status",
    "rationale",
    "recommendation",
    "decision_reference",
    "evidence",
    "validation",
    "implementation_issues"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exact_target": {
      "type": "string",
      "pattern": "^[0-9]+(?:\\.[0-9]+)+$"
    },
    "command_id": {
      "type": "string",
      "pattern": "^(?:documentation:[^\\r\\n]+\\.html?|sdk:[^\\r\\n]+\\.txt#[1-9][0-9]*)$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*$"
    },
    "mp_step": {
      "type": "string",
      "minLength": 1
    },
    "category_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "supported",
        "selected_for_v1",
        "under_review",
        "deferred_beyond_v1",
        "intentionally_excluded",
        "sdk_unavailable"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "summary"
      ],
      "properties": {
        "kind": {
          "enum": [
            "alternative",
            "workaround",
            "none_known",
            "not_applicable"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "decision_reference": {
      "$ref": "#/definitions/decision_reference"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/evidence_reference"
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "qualifiers",
        "summary"
      ],
      "properties": {
        "qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "at_risk"
            ]
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "briosa_operation": {
      "$ref": "#/definitions/briosa_operation"
    },
    "implementation_issues": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^https://github\\.com/spatialanalyzer/briosa/issues/[1-9][0-9]*$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "supported"
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "briosa_operation"
        ],
        "properties": {
          "recommendation": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "not_applicable"
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "not": {
          "type": "object",
          "required": [
            "briosa_operation"
          ]
        },
        "properties": {
          "recommendation": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "alternative",
                  "workaround",
                  "none_known"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "type": "object",
        "properties": {
          "status": {
            "const": "selected_for_v1"
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "implementation_issues": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    }
  ],
  "definitions": {
    "project_reference": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/(?:spatialanalyzer/(?:briosa|briosa-docs|governance)(?:/|$)|orgs/spatialanalyzer/discussions(?:/|$))"
    },
    "decision_reference": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/(?:spatialanalyzer/(?:briosa|briosa-docs|governance)/(?:issues|pull)/[1-9][0-9]*|orgs/spatialanalyzer/discussions/[1-9][0-9]*(?:#discussioncomment-[1-9][0-9]*)?)$"
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "exact_target_inventory",
            "authoritative_briosa_source",
            "reviewed_decision",
            "licensed_validation",
            "secondary_comparison"
          ]
        },
        "reference": {
          "$ref": "#/definitions/project_reference"
        }
      }
    },
    "briosa_operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id",
        "authoritative_reference"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
        },
        "authoritative_reference": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/spatialanalyzer/briosa/(?:blob|tree)/(?:main|[0-9a-f]{40})/targets/[0-9]+(?:\\.[0-9]+)+/"
        }
      }
    }
  }
}
