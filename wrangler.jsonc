{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "briosa-docs",
  "main": "./workers/downloads-proxy.js",
  "compatibility_date": "2026-11-28",
  // Keep custom domains and routes managed in the Cloudflare dashboard so CI
  // deploys require only an Individual Workers Editor token and never overwrite
  // dashboard-owned hostnames.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/downloads", "/downloads/*"]
  },
  "env": {
    "staging": {
      "name": "briosa-docs-staging",
      "workers_dev": false,
      "preview_urls": false
    }
  }
}
